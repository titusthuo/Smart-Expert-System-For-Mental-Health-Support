# Frontend Environment Variables
# Copy this file to .env.local and fill in the actual values

# Gemini API Key (get from https://ai.google.dev)
# Keep this SECRET - never commit the actual key to git
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# OpenCage Geocoding API Key (get from https://opencagedata.com/)
# Used for reverse geocoding (coordinates to city name)
# Keep this SECRET - never commit the actual key to git
EXPO_PUBLIC_OPENCAGE_API_KEY=your_opencage_api_key_here

# GraphQL Endpoint
# EXPO_PUBLIC_GRAPHQL_URL=https://smart-expert-system-backend.onrender.com/graphql/

# Mobile Origin
# EXPO_PUBLIC_MOBILE_ORIGIN=smart-expert-system-for-mental-health-support
